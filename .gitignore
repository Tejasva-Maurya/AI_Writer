# The user's novel stays on this machine and is never committed (KI-030, decision D-014).
# Back up data/ yourself: git no longer does it.
/data/

# Ignore Python bytecode and cache directories
__pycache__/
*.py[cod]
*$py.class

# Ignore virtual environments
venv/
env/
.env/

# Ignore IDE/editor directories
.vscode/
.idea/

# Ignore environment files and local settings
*.env
*.env.*

# Ignore logs and temporary files
*.log
*.tmp
*.bak
*.swp

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore build and dependency directories
node_modules/
build/
dist/

# Ignore database files
*.sqlite3

# Ignore coverage, test and lint artifacts
.coverage
.pytest_cache/
.ruff_cache/
htmlcov/

# Claude Code: personal settings and hook error log (shared settings.json and hooks ARE committed)
.claude/settings.local.json
.claude/hooks/hook-errors.log

# CodeAssist local index (graph + vector databases, regenerated by the tool)
.codeassist/
